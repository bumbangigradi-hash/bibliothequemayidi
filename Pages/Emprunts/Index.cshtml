@page
@model bibliotheque_mayidi.Pages.Emprunts.IndexModel

@{
    ViewData["Title"] = "Gestion des emprunts";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Gestion des emprunts</h1>
            <p class="text-muted mb-0">Enregistrement des prêts et suivi des retours.</p>
        </div>
        <a asp-page="/Index" class="btn btn-outline-secondary">Retour au tableau de bord</a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MessageSucces))
    {
        <div class="alert alert-success">@Model.MessageSucces</div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Impossible d'enregistrer le prêt :</strong>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Emprunts en cours</div>
                    <div class="fs-2 fw-bold text-primary">@Model.TotalEmpruntsEnCours</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Emprunts retournés</div>
                    <div class="fs-2 fw-bold text-success">@Model.TotalEmpruntsRetournes</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="text-muted small">Emprunts en retard</div>
                    <div class="fs-2 fw-bold text-danger">@Model.TotalEmpruntsEnRetard</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="h5 mb-0">Nouveau bordereau de prêt</h2>
        </div>

        <div class="card-body">
            <form method="post" asp-page-handler="Enregistrer" id="formEmprunt">
                @Html.AntiForgeryToken()

                <div class="alert alert-info">
                    Recherchez un lecteur, puis ajoutez les ouvrages à emprunter.
                    Chaque ligne possède sa propre date d'échéance, calculée selon
                    la durée de prêt du type de document.
                </div>

                <!-- RÉSERVATION -->
                <div class="mb-4 p-3 border rounded">
                    <label for="NumeroReservationSaisie" class="form-label fw-bold">
                        Retrait sur réservation
                    </label>
                    <div class="input-group">
                        <input type="text"
                               id="NumeroReservationSaisie"
                               name="NumeroReservationSaisie"
                               class="form-control"
                               placeholder="Saisir le numéro de réservation">
                        <button type="button" id="btnReservation" class="btn btn-outline-primary">
                            Charger
                        </button>
                    </div>
                    <div id="messageReservation" class="small mt-2"></div>
                    <div class="form-text">
                        Laissez ce champ vide pour enregistrer un prêt direct.
                    </div>
                </div>

                <!-- LECTEUR -->
                <div class="mb-4">
                    <label class="form-label fw-bold">Lecteur</label>
                    <input type="text"
                           id="rechercheLecteur"
                           class="form-control"
                           placeholder="Rechercher par numéro, matricule, nom ou identifiant..."
                           autocomplete="off">

                    <div id="resultatsLecteurs" class="list-group mt-2"></div>

                    <input type="hidden" asp-for="CodeLecteur" id="CodeLecteur">

                    <div id="lecteurSelectionne" class="alert alert-success mt-2 d-none"></div>
                </div>

                <!-- RECHERCHE OUVRAGE -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Ajouter un ouvrage</label>
                    <input type="text"
                           id="rechercheOuvrage"
                           class="form-control"
                           placeholder="Rechercher par titre ou code de document..."
                           autocomplete="off">

                    <div id="resultatsOuvrages" class="list-group mt-2"></div>
                </div>

                <!-- BORDEREAU -->
                <div class="table-responsive">
                    <table class="table table-bordered align-middle" id="tableLignes">
                        <thead class="table-light">
                            <tr>
                                <th style="width:5%">N°</th>
                                <th>Ouvrage</th>
                                <th>Type</th>
                                <th>Cote / Exemplaire</th>
                                <th>Durée</th>
                                <th>Date d'échéance</th>
                                <th style="width:8%">Action</th>
                            </tr>
                        </thead>
                        <tbody id="corpsLignes">
                            <tr id="ligneVide">
                                <td colspan="7" class="text-center text-muted py-4">
                                    Aucun ouvrage ajouté au bordereau.
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <strong id="nombreLignes">0 ouvrage(s)</strong>
                    <button type="button" id="viderBordereau" class="btn btn-sm btn-outline-danger">
                        Vider le bordereau
                    </button>
                </div>

                <!-- OBSERVATIONS -->
                <div class="mb-3">
                    <label asp-for="Observations" class="form-label">Observations</label>
                    <textarea asp-for="Observations"
                              class="form-control"
                              rows="2"
                              maxlength="1000"></textarea>
                </div>

                <button type="submit" class="btn btn-primary btn-lg" id="btnEnregistrer">
                    Enregistrer le bordereau de prêt
                </button>
            </form>
        </div>
    </div>

    <!-- HISTORIQUE -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0">Historique des emprunts</h2>
        </div>
        <div class="card-body">
            @if (Model.Emprunts.Count == 0)
            {
                <div class="alert alert-info mb-0">Aucun emprunt enregistré.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Bordereau</th>
                                <th>Lecteur</th>
                                <th>Document</th>
                                <th>Cote</th>
                                <th>Retrait</th>
                                <th>Échéance</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emprunt in Model.Emprunts)
                            {
                                var retard = emprunt.StatutLigne == "EN_COURS"
                                    && emprunt.DateEcheance < DateOnly.FromDateTime(DateTime.Today);

                                <tr>
                                    <td>@emprunt.CodeBordereauPretNavigation.NumeroBordereau</td>
                                    <td>@emprunt.CodeBordereauPretNavigation.CodeLecteurNavigation.NumeroLecteur</td>
                                    <td>@emprunt.CodeExemplaireNavigation.CodeDocumentNavigation.Titre</td>
                                    <td>@emprunt.CodeExemplaireNavigation.Cote</td>
                                    <td>@emprunt.DateRetrait.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@emprunt.DateEcheance.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @if (retard)
                                        {
                                            <span class="badge bg-danger">EN RETARD</span>
                                        }
                                        else if (emprunt.StatutLigne == "EN_COURS")
                                        {
                                            <span class="badge bg-primary">EN COURS</span>
                                        }
                                        else if (emprunt.StatutLigne == "RETOURNE")
                                        {
                                            <span class="badge bg-success">RETOURNÉ</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@emprunt.StatutLigne</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const urlBase = window.location.pathname;
            const rechercheLecteur = document.getElementById("rechercheLecteur");
            const resultatsLecteurs = document.getElementById("resultatsLecteurs");
            const codeLecteur = document.getElementById("CodeLecteur");
            const lecteurSelectionne = document.getElementById("lecteurSelectionne");

            const rechercheOuvrage = document.getElementById("rechercheOuvrage");
            const resultatsOuvrages = document.getElementById("resultatsOuvrages");
            const corpsLignes = document.getElementById("corpsLignes");
            const nombreLignes = document.getElementById("nombreLignes");

            const reservationInput = document.getElementById("NumeroReservationSaisie");
            const messageReservation = document.getElementById("messageReservation");
            const btnReservation = document.getElementById("btnReservation");

            let lignes = [];
            let reservationActive = false;

            function afficherMessage(element, message, classe) {
                element.className = "small mt-2 " + classe;
                element.textContent = message;
            }

            // RECHERCHE LECTEURS
            let timerLecteur;

            rechercheLecteur.addEventListener("input", function () {
                clearTimeout(timerLecteur);
                const q = this.value.trim();

                codeLecteur.value = "";
                lecteurSelectionne.classList.add("d-none");

                if (q.length < 2) {
                    resultatsLecteurs.innerHTML = "";
                    return;
                }

                timerLecteur = setTimeout(async () => {
                    try {
                        const response = await fetch(
                            `${urlBase}?handler=RechercherLecteurs&q=${encodeURIComponent(q)}`
                        );
                        const data = await response.json();

                        resultatsLecteurs.innerHTML = "";

                        if (!data.resultats || data.resultats.length === 0) {
                            resultatsLecteurs.innerHTML =
                                '<div class="list-group-item text-muted">Aucun lecteur trouvé.</div>';
                            return;
                        }

                        data.resultats.forEach(l => {
                            const bouton = document.createElement("button");
                            bouton.type = "button";
                            bouton.className = "list-group-item list-group-item-action";

                            const nom = [l.nom, l.postnom, l.prenom].filter(Boolean).join(" ");

                            bouton.textContent =
                                `${l.numero} — ${nom} — ${l.identifiant || ""}`;

                            bouton.addEventListener("click", () => {
                                codeLecteur.value = l.code;
                                lecteurSelectionne.textContent = "Lecteur sélectionné : " + bouton.textContent;
                                lecteurSelectionne.classList.remove("d-none");
                                rechercheLecteur.value = bouton.textContent;
                                resultatsLecteurs.innerHTML = "";
                            });

                            resultatsLecteurs.appendChild(bouton);
                        });
                    } catch {
                        resultatsLecteurs.innerHTML =
                            '<div class="list-group-item text-danger">Erreur de recherche des lecteurs.</div>';
                    }
                }, 300);
            });

            // RECHERCHE OUVRAGES
            let timerOuvrage;

            rechercheOuvrage.addEventListener("input", function () {
                clearTimeout(timerOuvrage);
                const q = this.value.trim();

                if (q.length < 2 || reservationActive) {
                    resultatsOuvrages.innerHTML = "";
                    return;
                }

                timerOuvrage = setTimeout(async () => {
                    try {
                        const response = await fetch(
                            `${urlBase}?handler=RechercherOuvrages&q=${encodeURIComponent(q)}`
                        );
                        const data = await response.json();

                        resultatsOuvrages.innerHTML = "";

                        if (!data.resultats || data.resultats.length === 0) {
                            resultatsOuvrages.innerHTML =
                                '<div class="list-group-item text-muted">Aucun ouvrage trouvé.</div>';
                            return;
                        }

                        data.resultats.forEach(d => {
                            const bloc = document.createElement("div");
                            bloc.className = "list-group-item";

                            const titre = document.createElement("div");
                            titre.className = "fw-bold";
                            titre.textContent = d.titre;

                            const details = document.createElement("div");
                            details.className = "small text-muted";
                            details.textContent =
                                `${d.type} — ${d.duree} jour(s) — ${d.nombreDisponible} exemplaire(s) disponible(s)`;

                            bloc.appendChild(titre);
                            bloc.appendChild(details);

                            if (d.nombreDisponible > 0) {
                                d.exemplaires.forEach(e => {
                                    const bouton = document.createElement("button");
                                    bouton.type = "button";
                                    bouton.className = "btn btn-sm btn-outline-primary mt-2 me-2";
                                    bouton.textContent = `Ajouter ${e.cote}`;

                                    bouton.addEventListener("click", () => {
                                        ajouterLigne({
                                            code: e.code,
                                            titre: d.titre,
                                            type: d.type,
                                            cote: e.cote,
                                            inventaire: e.inventaire,
                                            duree: d.duree
                                        });
                                    });

                                    bloc.appendChild(bouton);
                                });
                            } else {
                                const indisponible = document.createElement("span");
                                indisponible.className = "badge bg-danger mt-2";
                                indisponible.textContent = "Aucun exemplaire disponible";
                                bloc.appendChild(indisponible);
                            }

                            resultatsOuvrages.appendChild(bloc);
                        });
                    } catch {
                        resultatsOuvrages.innerHTML =
                            '<div class="list-group-item text-danger">Erreur de recherche des ouvrages.</div>';
                    }
                }, 300);
            });

            // AJOUT D'UNE LIGNE
            function ajouterLigne(ouvrage) {
                if (lignes.some(l => l.code === ouvrage.code)) {
                    alert("Cet exemplaire figure déjà dans le bordereau.");
                    return;
                }

                lignes.push(ouvrage);
                afficherLignes();
            }

            // AFFICHAGE DU BORDEREAU
            function afficherLignes() {
                corpsLignes.innerHTML = "";

                if (lignes.length === 0) {
                    corpsLignes.innerHTML =
                        '<tr><td colspan="7" class="text-center text-muted py-4">Aucun ouvrage ajouté au bordereau.</td></tr>';
                }

                lignes.forEach((ouvrage, index) => {
                    const echeance = new Date();
                    echeance.setHours(12, 0, 0, 0);
                    echeance.setDate(echeance.getDate() + Number(ouvrage.duree));

                    const date = echeance.toLocaleDateString("fr-FR");

                    const tr = document.createElement("tr");

                    const cellules = [
                        String(index + 1),
                        ouvrage.titre,
                        ouvrage.type,
                        `${ouvrage.cote} (${ouvrage.inventaire || "Sans inventaire"})`,
                        `${ouvrage.duree} jour(s)`,
                        date
                    ];

                    cellules.forEach(valeur => {
                        const td = document.createElement("td");
                        td.textContent = valeur;
                        tr.appendChild(td);
                    });

                    const action = document.createElement("td");
                    const supprimer = document.createElement("button");
                    supprimer.type = "button";
                    supprimer.className = "btn btn-sm btn-outline-danger";
                    supprimer.textContent = "Retirer";
                    supprimer.addEventListener("click", () => {
                        lignes.splice(index, 1);
                        afficherLignes();
                    });

                    action.appendChild(supprimer);
                    tr.appendChild(action);

                    const hidden = document.createElement("input");
                    hidden.type = "hidden";
                    hidden.name = "CodesExemplaires";
                    hidden.value = ouvrage.code;
                    tr.appendChild(document.createElement("td")).classList.add("d-none");
                    tr.lastChild.appendChild(hidden);

                    corpsLignes.appendChild(tr);
                });

                nombreLignes.textContent = `${lignes.length} ouvrage(s)`;
            }

            document.getElementById("viderBordereau").addEventListener("click", () => {
                lignes = [];
                afficherLignes();
            });

            // CHARGEMENT D'UNE RÉSERVATION
            btnReservation.addEventListener("click", async () => {
                const code = reservationInput.value.trim();

                if (!code) {
                    afficherMessage(messageReservation,
                        "Saisissez un numéro de réservation.", "text-danger");
                    return;
                }

                try {
                    const response = await fetch(
                        `${urlBase}?handler=ChargerReservation&code=${encodeURIComponent(code)}`
                    );
                    const data = await response.json();

                    if (!data.succes) {
                        afficherMessage(messageReservation, data.message, "text-danger");
                        return;
                    }

                    reservationActive = true;
                    codeLecteur.value = data.lecteur.code;
                    rechercheLecteur.value =
                        `${data.lecteur.numero} — ${data.lecteur.nom} ${data.lecteur.postnom || ""} ${data.lecteur.prenom || ""}`;

                    lecteurSelectionne.textContent = "Lecteur de la réservation : " + rechercheLecteur.value;
                    lecteurSelectionne.classList.remove("d-none");

                    lignes = [{
                        code: data.exemplaire.code,
                        titre: data.ouvrage.titre,
                        type: data.ouvrage.type,
                        cote: data.exemplaire.cote,
                        inventaire: data.exemplaire.inventaire,
                        duree: data.ouvrage.duree
                    }];

                    rechercheLecteur.disabled = true;
                    rechercheOuvrage.disabled = true;
                    reservationInput.readOnly = true;
                    btnReservation.disabled = true;

                    afficherLignes();

                    afficherMessage(messageReservation,
                        `Réservation ${data.reservation} chargée avec succès.`, "text-success");

                } catch {
                    afficherMessage(messageReservation,
                        "Impossible de charger cette réservation.", "text-danger");
                }
            });

            // VALIDATION AVANT ENREGISTREMENT
            document.getElementById("formEmprunt").addEventListener("submit", function (event) {
                if (!codeLecteur.value) {
                    event.preventDefault();
                    alert("Veuillez sélectionner un lecteur.");
                    return;
                }

                if (lignes.length === 0) {
                    event.preventDefault();
                    alert("Ajoutez au moins un ouvrage.");
                }
            });

            afficherLignes();
        });
    </script>
}
