@page
@model bibliotheque_mayidi.Pages.Emprunts.IndexModel

@{
    ViewData["Title"] = "Gestion des emprunts";
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Gestion des emprunts</h1>
            <p class="text-muted mb-0">
                Enregistrement des prêts et suivi des retours.
            </p>
        </div>

        <a asp-page="/Index" class="btn btn-outline-secondary">
            Retour au tableau de bord
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.MessageSucces))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Succès !</strong> @Model.MessageSucces
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fermer"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.MessageErreur))
    {
        <div class="alert alert-danger">
            @Model.MessageErreur
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <strong>Impossible d'enregistrer le prêt :</strong>
            <div asp-validation-summary="All"></div>
        </div>
    }

    <!-- STATISTIQUES -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Emprunts en cours</div>
                    <div class="fs-2 fw-bold text-primary">
                        @Model.TotalEmpruntsEnCours
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Emprunts retournés</div>
                    <div class="fs-2 fw-bold text-success">
                        @Model.TotalEmpruntsRetournes
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Emprunts en retard</div>
                    <div class="fs-2 fw-bold text-danger">
                        @Model.TotalEmpruntsEnRetard
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- NOUVEL EMPRUNT -->
    <div class="card border-0 shadow-sm mb-4">

        <div class="card-header bg-primary text-white py-3">
            <h2 class="h5 mb-0">Enregistrer un nouvel emprunt</h2>
        </div>

        <div class="card-body">

            @if (Model.Lecteurs.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    Aucun lecteur actif n'est disponible.
                    Vérifiez les inscriptions des lecteurs.
                </div>
            }
            else if (Model.ExemplairesDisponibles.Count == 0
                     && Model.ReservationsPretes.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    Aucun exemplaire disponible au prêt et aucune réservation
                    prête à être retirée.
                </div>
            }
            else
            {
                <form method="post" asp-page-handler="Enregistrer">

                    @Html.AntiForgeryToken()

                    <!-- RESERVATION -->
                    <div class="mb-4">
                        <label asp-for="CodeReservation" class="form-label fw-semibold">
                            Retrait sur réservation
                        </label>

                        <select asp-for="CodeReservation"
                                id="CodeReservation"
                                class="form-select">
                            <option value="">
                                Prêt direct — sans réservation
                            </option>

                            @foreach (var reservation in Model.ReservationsPretes)
                            {
                                <option value="@reservation.CodeReservation">
                                    @reservation.NumeroReservation
                                    — @reservation.CodeDocumentNavigation.Titre
                                    — Lecteur : @reservation.CodeLecteurNavigation.NumeroLecteur
                                    — Exemplaire : @reservation.CodeExemplaire
                                </option>
                            }
                        </select>

                        <small class="text-muted">
                            Sélectionnez une réservation prête pour retrouver
                            automatiquement le lecteur et l'exemplaire.
                            Pour un prêt direct, conservez l'option par défaut.
                        </small>
                    </div>

                    <div id="zonePretDirect" class="row g-3">

                        <!-- LECTEUR -->
                        <div class="col-md-6">
                            <label asp-for="CodeLecteur" class="form-label">
                                Lecteur
                            </label>

                            <select asp-for="CodeLecteur"
                                    id="CodeLecteur"
                                    class="form-select">
                                <option value="">
                                    -- Choisir un lecteur --
                                </option>

                                @foreach (var lecteur in Model.Lecteurs)
                                {
                                    <option value="@lecteur.CodeLecteur">
                                        @lecteur.NumeroLecteur
                                        — @lecteur.CodeCompteNavigation.Identifiant
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="CodeLecteur"
                                  class="text-danger"></span>
                        </div>

                        <!-- EXEMPLAIRE -->
                        <div class="col-md-6">
                            <label asp-for="CodeExemplaire" class="form-label">
                                Exemplaire à emprunter
                            </label>

                            <select asp-for="CodeExemplaire"
                                    id="CodeExemplaire"
                                    class="form-select">
                                <option value="">
                                    -- Choisir un exemplaire --
                                </option>

                                @foreach (var exemplaire in Model.ExemplairesDisponibles)
                                {
                                    <option value="@exemplaire.CodeExemplaire">
                                        @exemplaire.CodeDocumentNavigation.Titre
                                        — Cote : @exemplaire.Cote
                                        — Inventaire : @exemplaire.NumeroInventaire
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="CodeExemplaire"
                                  class="text-danger"></span>

                            <small class="text-muted">
                                Seuls les exemplaires disponibles sont proposés
                                pour un prêt direct.
                            </small>
                        </div>

                    </div>

                    <div id="infoReservation" class="alert alert-info mt-3 d-none">
                        <strong>Retrait sur réservation :</strong>
                        le lecteur et l'exemplaire seront récupérés depuis
                        la réservation sélectionnée. Les deux listes ci-dessus
                        ne sont pas nécessaires.
                    </div>

                    <!-- OBSERVATIONS -->
                    <div class="mt-3 mb-3">
                        <label asp-for="Observations" class="form-label">
                            Observations (facultatif)
                        </label>

                        <textarea asp-for="Observations"
                                  class="form-control"
                                  rows="3"
                                  maxlength="1000"
                                  placeholder="Remarques concernant le prêt..."></textarea>

                        <span asp-validation-for="Observations"
                              class="text-danger"></span>
                    </div>

                    <!-- BOUTON -->
                    <button type="submit" class="btn btn-primary">
                        Enregistrer le prêt
                    </button>

                </form>
            }

        </div>
    </div>

    <!-- HISTORIQUE -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0">Historique des emprunts</h2>
        </div>

        <div class="card-body">

            @if (Model.Emprunts.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    Aucun emprunt n'a encore été enregistré.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-striped table-hover align-middle">

                        <thead class="table-light">
                            <tr>
                                <th>Bordereau</th>
                                <th>Lecteur</th>
                                <th>Document</th>
                                <th>Cote</th>
                                <th>Date du retrait</th>
                                <th>Date d'échéance</th>
                                <th>Statut</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var emprunt in Model.Emprunts)
                            {
                                var estEnRetard =
                                    emprunt.StatutLigne == "EN_COURS"
                                    && emprunt.DateEcheance
                                       < DateOnly.FromDateTime(DateTime.Today);

                                <tr>
                                    <td>
                                        @emprunt.CodeBordereauPretNavigation.NumeroBordereau
                                    </td>

                                    <td>
                                        @emprunt.CodeBordereauPretNavigation
                                            .CodeLecteurNavigation.NumeroLecteur
                                    </td>

                                    <td>
                                        @emprunt.CodeExemplaireNavigation
                                            .CodeDocumentNavigation.Titre
                                    </td>

                                    <td>
                                        @emprunt.CodeExemplaireNavigation.Cote
                                    </td>

                                    <td>
                                        @emprunt.DateRetrait.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <td>
                                        @emprunt.DateEcheance.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @if (estEnRetard)
                                        {
                                            <span class="badge bg-danger">
                                                EN RETARD
                                            </span>
                                        }
                                        else if (emprunt.StatutLigne == "EN_COURS")
                                        {
                                            <span class="badge bg-primary">
                                                EN COURS
                                            </span>
                                        }
                                        else if (emprunt.StatutLigne == "RETOURNE")
                                        {
                                            <span class="badge bg-success">
                                                RETOURNÉ
                                            </span>
                                        }
                                        else if (emprunt.StatutLigne == "MANQUANT")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                MANQUANT
                                            </span>
                                        }
                                        else if (emprunt.StatutLigne == "PERDU")
                                        {
                                            <span class="badge bg-dark">
                                                PERDU
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                @emprunt.StatutLigne
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const reservation = document.getElementById("CodeReservation");
            const lecteur = document.getElementById("CodeLecteur");
            const exemplaire = document.getElementById("CodeExemplaire");
            const zonePretDirect = document.getElementById("zonePretDirect");
            const infoReservation = document.getElementById("infoReservation");

            function actualiserMode() {
                const avecReservation = reservation && reservation.value !== "";

                if (zonePretDirect) {
                    zonePretDirect.classList.toggle("opacity-50", avecReservation);
                }

                if (infoReservation) {
                    infoReservation.classList.toggle("d-none", !avecReservation);
                }

                if (lecteur) {
                    lecteur.disabled = avecReservation;
                    lecteur.required = !avecReservation;
                }

                if (exemplaire) {
                    exemplaire.disabled = avecReservation;
                    exemplaire.required = !avecReservation;
                }
            }

            if (reservation) {
                reservation.addEventListener("change", actualiserMode);
                actualiserMode();
            }
        });
    </script>
}