@page
@model bibliotheque_mayidi.Pages.Lecteurs.IndexModel

@{
    ViewData["Title"] = "Gestion des lecteurs";
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="h2">Gestion des lecteurs</h1>
            <p class="text-muted mb-0">
                Consulter, rechercher et gérer les lecteurs de la bibliothèque.
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            <span class="me-1">+</span> Ajouter un lecteur
        </a>
    </div>

    @if (TempData["Succes"] is string succes)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @succes
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    @if (TempData["Erreur"] is string erreur)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @erreur
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Total des lecteurs</div>
                    <div class="fs-3 fw-bold">@Model.TotalLecteurs</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Lecteurs actifs</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalActifs</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Lecteurs suspendus</div>
                    <div class="fs-3 fw-bold text-danger">@Model.TotalSuspendus</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label asp-for="Recherche" class="form-label">
                        Recherche
                    </label>
                    <input asp-for="Recherche"
                           class="form-control"
                           placeholder="Nom, identifiant, numéro ou matricule..." />
                </div>

                <div class="col-md-3">
                    <label asp-for="CategorieSelectionnee" class="form-label">
                        Catégorie
                    </label>
                    <select asp-for="CategorieSelectionnee" class="form-select">
                        <option value="">Toutes les catégories</option>
                        <option value="SEMINARISTE">Séminariste</option>
                        <option value="FORMATEUR">Formateur</option>
                        <option value="PRETRE">Prêtre</option>
                        <option value="PERSONNEL">Personnel</option>
                        <option value="AUTRE">Autre</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label asp-for="StatutSelectionne" class="form-label">
                        Statut
                    </label>
                    <select asp-for="StatutSelectionne" class="form-select">
                        <option value="">Tous</option>
                        <option value="ACTIF">Actif</option>
                        <option value="SUSPENDU">Suspendu</option>
                        <option value="INACTIF">Inactif</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Rechercher
                    </button>
                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Réinitialiser
                    </a>
                </div>

            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>Liste des lecteurs</strong>
            <span class="text-muted">
                @Model.Lecteurs.Count résultat(s)
            </span>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Numéro</th>
                        <th>Nom complet</th>
                        <th>Matricule</th>
                        <th>Catégorie</th>
                        <th>Inscription</th>
                        <th>Expiration</th>
                        <th>Statut</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Lecteurs.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                <div class="mb-2">
                                    Aucun lecteur trouvé.
                                </div>
                                <a asp-page="./Create" class="btn btn-sm btn-primary">
                                    Ajouter le premier lecteur
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var lecteur in Model.Lecteurs)
                        {
                            <tr>
                                <td>
                                    <strong>@lecteur.NumeroLecteur</strong>
                                </td>

                                <td>
                                    @lecteur.CodeCompteNavigation.NomUtilisateur
                                    @lecteur.CodeCompteNavigation.Prenom
                                    @lecteur.CodeCompteNavigation.Postnom

                                    <div class="small text-muted">
                                        @lecteur.CodeCompteNavigation.Identifiant
                                    </div>
                                </td>

                                <td>
                                    @(lecteur.MatriculeSeminaire ?? "—")
                                </td>

                                <td>
                                    @switch (lecteur.CategorieLecteur)
                                    {
                                        case "SEMINARISTE":
                                            <span>Séminariste</span>
                                            break;
                                        case "FORMATEUR":
                                            <span>Formateur</span>
                                            break;
                                        case "PRETRE":
                                            <span>Prêtre</span>
                                            break;
                                        case "PERSONNEL":
                                            <span>Personnel</span>
                                            break;
                                        default:
                                            <span>Autre</span>
                                            break;
                                    }
                                </td>

                                <td>
                                    @lecteur.DateInscription.ToString("dd/MM/yyyy")
                                </td>

                                <td>
                                    @(lecteur.DateExpiration?.ToString("dd/MM/yyyy") ?? "—")
                                </td>

                                <td>
                                    @if (lecteur.StatutLecteur == "ACTIF")
                                    {
                                        <span class="badge bg-success">Actif</span>
                                    }
                                    else if (lecteur.StatutLecteur == "SUSPENDU")
                                    {
                                        <span class="badge bg-danger">Suspendu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @lecteur.StatutLecteur
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
