@page
@model bibliotheque_mayidi.Pages.Reservations.IndexModel

@{
    ViewData["Title"] = "Gestion des réservations";
}

<div class="container-fluid py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-calendar-check me-2"></i>
                Gestion des réservations
            </h1>
            <p class="text-muted mb-0">
                Consultez les demandes et gérez la disponibilité des documents.
            </p>
        </div>

        <a asp-page="/Catalogue/Index" class="btn btn-outline-secondary">
            <i class="bi bi-book me-1"></i> Voir le catalogue
        </a>
    </div>

    @if (TempData["ConfirmationReservation"] is string confirmation)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>
            @confirmation
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Fermer"></button>
        </div>
    }

    @if (TempData["ErreurReservation"] is string erreur)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @erreur
            <button type="button" class="btn-close" data-bs-dismiss="alert"
                    aria-label="Fermer"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">Total des demandes</div>
                    <div class="fs-3 fw-bold">@Model.TotalReservations</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow-sm h-100 border-warning">
                <div class="card-body">
                    <div class="text-muted small">En attente</div>
                    <div class="fs-3 fw-bold text-warning">@Model.EnAttente</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small">En vérification</div>
                    <div class="fs-3 fw-bold">@Model.EnVerification</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow-sm h-100 border-info">
                <div class="card-body">
                    <div class="text-muted small">Prêtes au retrait</div>
                    <div class="fs-3 fw-bold text-info">@Model.Pretes</div>
                </div>
            </div>
        </div>

        <div class="col-6 col-md-4 col-xl">
            <div class="card shadow-sm h-100 border-success">
                <div class="card-body">
                    <div class="text-muted small">Honorées</div>
                    <div class="fs-3 fw-bold text-success">@Model.Honorees</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-7">
                    <label for="Recherche" class="form-label">
                        Rechercher une réservation
                    </label>
                    <input asp-for="Recherche"
                           class="form-control"
                           placeholder="Numéro, titre, numéro du lecteur ou identifiant..." />
                </div>

                <div class="col-md-3">
                    <label for="Filtre" class="form-label">Statut</label>
                    <select asp-for="Filtre" class="form-select">
                        <option value="TOUTES">Toutes les réservations</option>
                        <option value="EN_ATTENTE">En attente</option>
                        <option value="EN_VERIFICATION">En vérification</option>
                        <option value="PRETE">Prêtes au retrait</option>
                        <option value="HONOREE">Honorées</option>
                        <option value="EXPIREE">Expirées</option>
                        <option value="ANNULEE">Annulées</option>
                        <option value="REFUSEE">Refusées</option>
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-search me-1"></i> Filtrer
                    </button>
                    <a asp-page="/Reservations/Index"
                       class="btn btn-outline-secondary"
                       title="Réinitialiser">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    @if (Model.Reservations.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox display-4 text-muted"></i>
                <h2 class="h5 mt-3">Aucune réservation trouvée</h2>
                <p class="text-muted mb-0">
                    Modifiez les critères de recherche ou consultez les demandes plus tard.
                </p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var reservation in Model.Reservations)
            {
                var statut = reservation.StatutReservation;
                var badge = statut switch
                {
                    "EN_ATTENTE" => "bg-warning text-dark",
                    "EN_VERIFICATION" => "bg-secondary",
                    "PRETE" => "bg-info text-dark",
                    "HONOREE" => "bg-success",
                    "EXPIREE" => "bg-dark",
                    "ANNULEE" => "bg-light text-dark border",
                    "REFUSEE" => "bg-danger",
                    _ => "bg-secondary"
                };

                var compte = reservation.CodeLecteurNavigation.CodeCompteNavigation;
                var nomLecteur = string.Join(" ", new[]
                {
                    compte.Prenom,
                    compte.NomUtilisateur,
                    compte.Postnom
                }.Where(n => !string.IsNullOrWhiteSpace(n)));

                <div class="col-12 col-xl-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <strong>
                                <i class="bi bi-ticket-perforated me-1"></i>
                                @reservation.NumeroReservation
                            </strong>
                            <span class="badge @badge">@statut.Replace("_", " ")</span>
                        </div>

                        <div class="card-body">
                            <h2 class="h5 mb-2">
                                @reservation.CodeDocumentNavigation.Titre
                            </h2>

                            <div class="row g-3 mb-3">
                                <div class="col-sm-6">
                                    <div class="small text-muted">Lecteur</div>
                                    <div class="fw-semibold">
                                        @(string.IsNullOrWhiteSpace(nomLecteur)
                                            ? compte.Identifiant
                                            : nomLecteur)
                                    </div>
                                    <div class="small text-muted">
                                        N° lecteur : @reservation.CodeLecteurNavigation.NumeroLecteur
                                    </div>
                                </div>

                                <div class="col-sm-6">
                                    <div class="small text-muted">Date de demande</div>
                                    <div>
                                        @reservation.DateReservation.ToString("dd/MM/yyyy HH:mm")
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(reservation.CodeExemplaireNavigation?.NumeroInventaire))
                                    {
                                        <div class="small mt-1">
                                            Inventaire :
                                            @reservation.CodeExemplaireNavigation.NumeroInventaire
                                        </div>
                                    }
                                </div>
                            </div>

                            @if (reservation.DateLimiteRetrait.HasValue &&
                                 statut == "PRETE")
                            {
                                <div class="alert alert-info py-2 mb-3">
                                    <i class="bi bi-clock me-1"></i>
                                    Retrait avant le
                                    <strong>
                                        @reservation.DateLimiteRetrait.Value.ToString("dd/MM/yyyy HH:mm")
                                    </strong>
                                </div>
                            }

                            @if (statut == "REFUSEE" &&
                                 !string.IsNullOrWhiteSpace(reservation.MotifRefus))
                            {
                                <div class="alert alert-danger py-2 mb-3">
                                    <strong>Motif du refus :</strong>
                                    @reservation.MotifRefus
                                </div>
                            }

                            @if (statut == "EN_ATTENTE" ||
                                 statut == "EN_VERIFICATION")
                            {
                                <div class="border-top pt-3 mt-2">
                                    <form method="post"
                                          asp-page-handler="Valider"
                                          asp-route-codeReservation="@reservation.CodeReservation"
                                          class="mb-3">
                                        <input type="hidden" name="Filtre" value="@Model.Filtre" />
                                        <input type="hidden" name="Recherche" value="@Model.Recherche" />

                                        <button type="submit"
                                                class="btn btn-success w-100"
                                                onclick="return confirm('Confirmer la validation de cette réservation ?');">
                                            <i class="bi bi-check-circle me-1"></i>
                                            Valider et préparer le document
                                        </button>
                                    </form>

                                    <form method="post"
                                          asp-page-handler="Refuser"
                                          asp-route-codeReservation="@reservation.CodeReservation">
                                        <input type="hidden" name="Filtre" value="@Model.Filtre" />
                                        <input type="hidden" name="Recherche" value="@Model.Recherche" />

                                        <label class="form-label"
                                               for="motif-@reservation.CodeReservation">
                                            Motif du refus
                                        </label>

                                        <textarea id="motif-@reservation.CodeReservation"
                                                  name="MotifRefus"
                                                  class="form-control mb-2"
                                                  rows="2"
                                                  maxlength="1000"
                                                  placeholder="Expliquez pourquoi la demande est refusée..."
                                                  required></textarea>

                                        <button type="submit"
                                                class="btn btn-outline-danger w-100"
                                                onclick="return confirm('Confirmer le refus de cette réservation ?');">
                                            <i class="bi bi-x-circle me-1"></i>
                                            Refuser la demande
                                        </button>
                                    </form>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>
