
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Bibliothèque de Mayidi</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/bibliotheque_mayidi.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark"
             style="background:#14532d;">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-page="/Index">

                    <i class="bi bi-book-half me-2"></i>
                    Bibliothèque de Mayidi
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Ouvrir le menu">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="menuPrincipal">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i>
                                Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Catalogue/Index">
                                <i class="bi bi-journals me-1"></i>
                                Catalogue
                            </a>
                        </li>

                        @if (User.Identity?.IsAuthenticated == true &&
                             (User.IsInRole("ADMINISTRATEUR") ||
                              User.IsInRole("BIBLIOTHECAIRE") ||
                              User.IsInRole("GESTIONNAIRE")))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Bibliothecaire/Index">
                                    <i class="bi bi-speedometer2 me-1"></i>
                                    Espace bibliothécaire
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav">

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle me-1"></i>
                                    @User.Identity.Name
                                </span>
                            </li>

                            <li class="nav-item">
                                <form method="post"
                                      asp-page="/Deconnexion">
                                    <button type="submit"
                                            class="btn btn-outline-light btn-sm mt-1">
                                        <i class="bi bi-box-arrow-right me-1"></i>
                                        Déconnexion
                                    </button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm mt-1"
                                   asp-page="/Connexion">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Connexion
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <footer class="border-top mt-5 py-4 bg-light">
        <div class="container text-center">

            <div class="fw-semibold text-success">
                Bibliothèque du Grand Séminaire
                Saint Robert Bellarmin de Mayidi
            </div>

            <small class="text-muted">
                © @DateTime.Now.Year - Tous droits réservés
            </small>

        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
