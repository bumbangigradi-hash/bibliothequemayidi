@page
@model bibliotheque_mayidi.Pages.Bibliothecaire.IndexModel

@{
    ViewData["Title"] = "Espace bibliothécaire";
}

<style>
    .entete-bibliothecaire {
        background: linear-gradient(120deg, #14532d, #166534);
        color: white;
        padding: 28px;
        border-radius: 12px;
        margin-bottom: 25px;
    }

    .carte-fonction {
        border: none;
        border-radius: 12px;
        transition: transform .2s, box-shadow .2s;
    }

        .carte-fonction:hover {
            transform: translateY(-4px);
            box-shadow: 0 7px 18px rgba(0,0,0,.10) !important;
        }

    .icone-fonction {
        font-size: 32px;
        margin-bottom: 14px;
    }

    .btn-bibliotheque {
        background: #14532d;
        color: white;
        border: none;
    }

        .btn-bibliotheque:hover {
            background: #166534;
            color: white;
        }

    .statistique {
        border-left: 4px solid #166534;
        border-radius: 8px;
    }

    .carte-session {
        border: none;
        border-radius: 12px;
        overflow: hidden;
    }

    .session-entete {
        background: #f0fdf4;
        border-bottom: 1px solid #dcfce7;
        color: #14532d;
        padding: 17px 20px;
    }

    .session-indicateur {
        background: #f8fafc;
        border-radius: 10px;
        padding: 18px;
    }
</style>

<div class="container py-4">

    <!-- EN-TÊTE -->
    <div class="entete-bibliothecaire">

        <h1>
            <i class="bi bi-book-half"></i>
            Espace bibliothécaire
        </h1>

        <p class="mb-0">
            Bibliothèque du Grand Séminaire Saint Robert Bellarmin de Mayidi
        </p>

        <p class="mt-2 mb-0">
            Gestion des documents, collections, réservations et emprunts.
        </p>

    </div>

    <!-- MESSAGES -->
    @if (TempData["SuccesSession"] is string succesSession)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @succesSession
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErreurSession"] is string erreurSession)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @erreurSession
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATISTIQUES -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card statistique shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total des réservations</h6>
                    <h2 class="fw-bold text-primary">
                        @Model.TotalReservations
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card statistique shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Total des lecteurs</h6>
                    <h2 class="fw-bold text-success">
                        @Model.TotalLecteurs
                    </h2>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card statistique shadow-sm h-100">
                <div class="card-body">
                    <h6 class="text-muted">Emprunts en cours</h6>
                    <h2 class="fw-bold text-warning">
                        @Model.TotalEmpruntsEnCours
                    </h2>
                </div>
            </div>
        </div>

    </div>

    <!-- SESSION D'ENREGISTREMENT -->
    <div class="card carte-session shadow-sm mb-4">

        <div class="session-entete">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-journal-check me-2"></i>
                Session d'enregistrement des documents
            </h5>
        </div>

        <div class="card-body p-4">

            @if (Model.SessionOuverte)
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">

                    <div>
                        <span class="badge bg-success mb-2">
                            <i class="bi bi-circle-fill me-1"></i>
                            SESSION OUVERTE
                        </span>

                        <h5 class="fw-bold mb-1">
                            Session n° @Model.CodeSessionActive
                        </h5>

                        <p class="text-muted mb-0">
                            Ouverte le
                            @Model.DateOuvertureSession?.ToString("dd/MM/yyyy à HH:mm")
                        </p>
                    </div>

                    <form method="post"
                          asp-page-handler="CloturerSession"
                          onsubmit="return confirm('Voulez-vous vraiment clôturer votre session d’enregistrement ?');">

                        <button type="submit" class="btn btn-outline-danger">
                            <i class="bi bi-lock-fill me-2"></i>
                            Clôturer ma session
                        </button>

                    </form>

                </div>

                <div class="row g-3">

                    <div class="col-md-6">
                        <div class="session-indicateur">
                            <h6 class="text-muted">
                                Exemplaires enregistrés pendant cette session
                            </h6>

                            <h2 class="fw-bold text-success mb-0">
                                @Model.ExemplairesSession
                            </h2>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="session-indicateur h-100 d-flex flex-column justify-content-center">
                            <p class="mb-2">
                                <i class="bi bi-info-circle text-success me-2"></i>
                                Votre session est active. Vous pouvez maintenant enregistrer de nouveaux documents.
                            </p>

                            <a asp-page="/Documents/Create"
                               class="btn btn-bibliotheque align-self-start">
                                <i class="bi bi-plus-circle me-2"></i>
                                Ajouter un document
                            </a>
                        </div>
                    </div>

                </div>
            }
            else
            {
                <div class="text-center py-3">

                    <div class="mb-3">
                        <i class="bi bi-lock display-4 text-secondary"></i>
                    </div>

                    <h5 class="fw-bold">
                        Aucune session d'enregistrement ouverte
                    </h5>

                    <p class="text-muted">
                        Ouvrez une session pour commencer à enregistrer
                        des documents et leurs exemplaires physiques.
                    </p>

                    <form method="post" asp-page-handler="OuvrirSession">

                        <button type="submit" class="btn btn-bibliotheque btn-lg">
                            <i class="bi bi-unlock me-2"></i>
                            Ouvrir ma session d'enregistrement
                        </button>

                    </form>

                </div>
            }

        </div>
    </div>

    <!-- ÉTAT DES RÉSERVATIONS -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-white">
            <h5 class="mb-0 fw-bold">
                <i class="bi bi-calendar-check"></i>
                État des réservations
            </h5>
        </div>

        <div class="card-body">

            <div class="row text-center g-3">

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6 class="text-muted">En attente</h6>
                        <h3 class="text-warning fw-bold">
                            @Model.ReservationsEnAttente
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6 class="text-muted">En vérification</h6>
                        <h3 class="text-info fw-bold">
                            @Model.ReservationsEnVerification
                        </h3>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="p-3 bg-light rounded">
                        <h6 class="text-muted">Prêtes</h6>
                        <h3 class="text-success fw-bold">
                            @Model.ReservationsPretes
                        </h3>
                    </div>
                </div>

            </div>

        </div>
    </div>

    <!-- MODULES -->
    <div class="row g-3">

        <!-- RÉSERVATIONS -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">📌</div>

                    <h5 class="card-title">Réservations</h5>

                    <p class="card-text">
                        Consultez les demandes et traitez chaque ouvrage
                        individuellement.
                    </p>

                    <a asp-page="/Reservations/Index"
                       class="btn btn-primary">
                        Gérer les réservations
                    </a>

                </div>
            </div>
        </div>

        <!-- EMPRUNTS -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">📖</div>

                    <h5 class="card-title">Emprunts et retours</h5>

                    <p class="card-text">
                        Accédez à la gestion des prêts et des retours.
                    </p>

                    <a asp-page="/Emprunts/Index"
                       class="btn btn-primary">
                        Gérer les emprunts
                    </a>

                </div>
            </div>
        </div>

        <!-- LECTEURS -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">👥</div>

                    <h5 class="card-title">Lecteurs</h5>

                    <p class="card-text">
                        Consultez les dossiers des lecteurs inscrits.
                    </p>

                    <a asp-page="/Lecteurs/Index"
                       class="btn btn-primary">
                        Gérer les lecteurs
                    </a>

                </div>
            </div>
        </div>

        <!-- CATALOGUE -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">📚</div>

                    <h5 class="card-title">Catalogue</h5>

                    <p class="card-text">
                        Recherchez les documents, leurs descriptions
                        et leurs exemplaires.
                    </p>

                    <a asp-page="/Catalogue/Index"
                       class="btn btn-outline-primary">
                        Ouvrir le catalogue
                    </a>

                </div>
            </div>
        </div>

        <!-- AJOUTER UN DOCUMENT -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">➕📚</div>

                    <h5 class="card-title">Ajouter un document</h5>

                    <p class="card-text">
                        Enregistrez de nouveaux livres, manuels,
                        revues, dictionnaires et autres documents.
                    </p>

                    @if (Model.SessionOuverte)
                    {
                        <a asp-page="/Documents/Create"
                           class="btn btn-bibliotheque">
                            Ajouter un document
                        </a>
                    }
                    else
                    {
                        <button type="button"
                                class="btn btn-secondary"
                                disabled
                                title="Ouvrez d'abord une session d'enregistrement">
                            Session nécessaire
                        </button>
                    }

                </div>
            </div>
        </div>

        <!-- COLLECTIONS -->
        <div class="col-md-6 col-lg-4">
            <div class="card carte-fonction h-100 shadow-sm">
                <div class="card-body">

                    <div class="icone-fonction">🗂️</div>

                    <h5 class="card-title">Collections</h5>

                    <p class="card-text">
                        Créez et organisez les collections documentaires
                        de la bibliothèque.
                    </p>

                    <a asp-page="/Bibliothecaire/Collections/Index"
                       class="btn btn-bibliotheque">
                        Gérer les collections
                    </a>

                </div>
            </div>
        </div>

    </div>

</div>
