@page "{id:int}"
@model bibliotheque_mayidi.Pages.Documents.DetailsModel

@{
    ViewData["Title"] = "Fiche détaillée du document";
}

<div class="container py-4">

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2">Fiche détaillée du document</h1>
            <p class="text-muted mb-0">
                Bibliothèque du Grand Séminaire de Mayidi
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-page="./Index" class="btn btn-outline-secondary">
                Retour au catalogue
            </a>

            <a asp-page="./Edit"
               asp-route-id="@Model.Document!.CodeDocument"
               class="btn btn-primary">
                Modifier le document
            </a>
        </div>
    </div>

    @if (TempData["Succes"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Succes"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Fermer"></button>
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            Informations bibliographiques
        </div>

        <div class="card-body">
            <h2 class="h4">@Model.Document!.Titre</h2>

            @if (!string.IsNullOrWhiteSpace(Model.Document.SousTitre))
            {
                <p class="text-muted">@Model.Document.SousTitre</p>
            }

            <dl class="row">
                <dt class="col-md-3">Code du document</dt>
                <dd class="col-md-9">@Model.Document.CodeDocument</dd>

                <dt class="col-md-3">Type</dt>
                <dd class="col-md-9">
                    @Model.Document.CodeTypeDocumentNavigation.NomTypeDocument
                </dd>

                <dt class="col-md-3">Auteur(s)</dt>
                <dd class="col-md-9">
                    @(string.IsNullOrWhiteSpace(Model.Auteurs)
                        ? "Non renseigné"
                        : Model.Auteurs)
                </dd>

                <dt class="col-md-3">ISBN / ISSN</dt>
                <dd class="col-md-9">
                    @(Model.Document.IsbnIssn ?? "Non renseigné")
                </dd>

                <dt class="col-md-3">Édition</dt>
                <dd class="col-md-9">
                    @(Model.Document.Edition ?? "Non renseignée")
                </dd>

                <dt class="col-md-3">Éditeur (code)</dt>
                <dd class="col-md-9">
                    @(Model.Document.CodeEditeur?.ToString() ?? "Non renseigné")
                </dd>

                <dt class="col-md-3">Collection (code)</dt>
                <dd class="col-md-9">
                    @(Model.Document.CodeCollection?.ToString() ?? "Non renseignée")
                </dd>

                <dt class="col-md-3">Lieu de publication</dt>
                <dd class="col-md-9">
                    @(Model.Document.LieuPublication ?? "Non renseigné")
                </dd>

                <dt class="col-md-3">Année de publication</dt>
                <dd class="col-md-9">
                    @(Model.Document.AnneePublication?.ToString() ?? "Non renseignée")
                </dd>

                <dt class="col-md-3">Langue</dt>
                <dd class="col-md-9">
                    @(Model.Document.Langue ?? "Non renseignée")
                </dd>

                <dt class="col-md-3">Nombre de pages</dt>
                <dd class="col-md-9">
                    @(Model.Document.NombrePages?.ToString() ?? "Non renseigné")
                </dd>

                <dt class="col-md-3">Emprunt autorisé</dt>
                <dd class="col-md-9">
                    @(Model.Document.EmpruntAutorise ? "Oui" : "Non")
                </dd>

                <dt class="col-md-3">Statut de la notice</dt>
                <dd class="col-md-9">@Model.Document.StatutNotice</dd>
            </dl>

            <hr />

            <h3 class="h5">Résumé</h3>

            @if (!string.IsNullOrWhiteSpace(Model.Document.Resume))
            {
                <p class="text-break">@Model.Document.Resume</p>
            }
            else
            {
                <p class="text-muted">Aucun résumé renseigné.</p>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Document.MotsCles))
            {
                <h3 class="h5 mt-3">Mots-clés</h3>
                <p>@Model.Document.MotsCles</p>
            }
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            État des exemplaires
        </div>

        <div class="card-body">
            <div class="row g-3 text-center">

                <div class="col-6 col-md">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Total</div>
                        <div class="fs-3 fw-bold">@Model.NombreExemplaires</div>
                    </div>
                </div>

                <div class="col-6 col-md">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Disponibles</div>
                        <div class="fs-3 fw-bold text-success">
                            @Model.NombreDisponibles
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Empruntés</div>
                        <div class="fs-3 fw-bold text-primary">
                            @Model.NombreEmpruntes
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Réservés</div>
                        <div class="fs-3 fw-bold text-warning">
                            @Model.NombreReserves
                        </div>
                    </div>
                </div>

                <div class="col-6 col-md">
                    <div class="border rounded p-3 h-100">
                        <div class="text-muted">Endommagés</div>
                        <div class="fs-3 fw-bold text-danger">
                            @Model.NombreEndommages
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <span>Liste des exemplaires et classement physique</span>

            <a asp-page="/Exemplaires/Create"
               class="btn btn-sm btn-primary">
                + Ajouter un exemplaire
            </a>
        </div>

        <div class="card-body">
            @if (Model.Document.Exemplaires.Count == 0)
            {
                <div class="alert alert-info mb-0">
                    Aucun exemplaire n'est encore associé à ce document.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Inventaire</th>
                                <th>Cote</th>
                                <th>Rayon</th>
                                <th>Étagère</th>
                                <th>Place</th>
                                <th>État</th>
                                <th>Statut</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var exemplaire in Model.Document.Exemplaires
                                .OrderBy(e => e.Cote))
                            {
                                <tr>
                                    <td>@exemplaire.NumeroInventaire</td>

                                    <td>
                                        <strong>@exemplaire.Cote</strong>
                                    </td>

                                    <td>
                                        @exemplaire.CodeEmplacementNavigation
                                        .CodeEtagereNavigation
                                        .CodeRayonNavigation.NomRayon
                                    </td>

                                    <td>
                                        @exemplaire.CodeEmplacementNavigation
                                        .CodeEtagereNavigation.NumeroEtagereRoman
                                    </td>

                                    <td>
                                        @exemplaire.CodeEmplacementNavigation.NumeroPlace
                                    </td>

                                    <td>@exemplaire.EtatDocument</td>

                                    <td>
                                        @switch (exemplaire.StatutExemplaire)
                                        {
                                            case "DISPONIBLE":
                                                <span class="badge bg-success">
                                                    Disponible
                                                </span>
                                                break;

                                            case "EMPRUNTE":
                                                <span class="badge bg-primary">
                                                    Emprunté
                                                </span>
                                                break;

                                            case "RESERVE":
                                                <span class="badge bg-warning text-dark">
                                                    Réservé
                                                </span>
                                                break;

                                            case "CONSULTATION":
                                                <span class="badge bg-info text-dark">
                                                    Consultation
                                                </span>
                                                break;

                                            case "ENDOMMAGE":
                                                <span class="badge bg-danger">
                                                    Endommagé
                                                </span>
                                                break;

                                            case "PERDU":
                                                <span class="badge bg-dark">
                                                    Perdu
                                                </span>
                                                break;

                                            case "RETIRE":
                                                <span class="badge bg-secondary">
                                                    Retiré
                                                </span>
                                                break;

                                            default:
                                                <span class="badge bg-secondary">
                                                    @exemplaire.StatutExemplaire
                                                </span>
                                                break;
                                        }
                                    </td>

                                    <td>
                                        <div class="d-flex flex-wrap gap-1">
                                            <a asp-page="/Exemplaires/Details"
                                               asp-route-id="@exemplaire.CodeExemplaire"
                                               class="btn btn-sm btn-outline-primary">
                                                Détails
                                            </a>

                                            <a asp-page="/Exemplaires/Edit"
                                               asp-route-id="@exemplaire.CodeExemplaire"
                                               class="btn btn-sm btn-outline-secondary">
                                                Modifier
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="d-flex flex-wrap gap-2 mt-4">
        <a asp-page="./Index" class="btn btn-outline-secondary">
            Retour au catalogue
        </a>

        <a asp-page="/Exemplaires/Index" class="btn btn-outline-primary">
            Gestion des exemplaires
        </a>
    </div>

</div>
