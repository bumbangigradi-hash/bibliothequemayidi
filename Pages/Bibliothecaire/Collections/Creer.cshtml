@page
@model bibliotheque_mayidi.Pages.Bibliothecaire.Collections.CreerModel

@{
    ViewData["Title"] = "Ajouter une collection";
}

<div class="container py-4">

    <div class="mb-4">
        <h2 class="fw-bold">Ajouter une collection</h2>
        <p class="text-muted">
            Enregistrer une nouvelle collection dans le catalogue.
        </p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <form method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Formulaire.NomCollection"
                           class="form-label fw-semibold">
                        Nom de la collection *
                    </label>

                    <input asp-for="Formulaire.NomCollection"
                           class="form-control"
                           placeholder="Exemple : Philosophie africaine" />

                    <span asp-validation-for="Formulaire.NomCollection"
                          class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Formulaire.Description"
                           class="form-label fw-semibold">
                        Description
                    </label>

                    <textarea asp-for="Formulaire.Description"
                              class="form-control"
                              rows="4"
                              placeholder="Description facultative de la collection..."></textarea>

                    <span asp-validation-for="Formulaire.Description"
                          class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">
                        Enregistrer la collection
                    </button>

                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Annuler
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
