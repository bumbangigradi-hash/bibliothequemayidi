@page
@model bibliotheque_mayidi.Pages.DeconnexionModel

@{
    ViewData["Title"] = "Déconnexion";
}

<div class="container mt-5">
    <div class="card shadow-sm mx-auto" style="max-width: 450px;">
        <div class="card-body text-center p-4">
            <h3 class="mb-3">Déconnexion</h3>

            <p>Voulez-vous vraiment vous déconnecter de votre compte ?</p>

            <form method="post">
                <button type="submit" class="btn btn-danger">
                    Se déconnecter
                </button>

                <a asp-page="/Index" class="btn btn-secondary ms-2">
                    Annuler
                </a>
            </form>
        </div>
    </div>
</div>
