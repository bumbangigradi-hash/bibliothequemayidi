@page
@model bibliotheque_mayidi.Pages.EspaceLecteur.NotificationsModel

@{
    ViewData["Title"] = "Mes notifications";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h2">Mes notifications</h1>
        <p class="text-muted">
            Bonjour @Model.NomLecteur, retrouvez ici les messages de la bibliothèque.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Notifications actives</div>
                    <div class="fs-3 fw-bold">@Model.TotalMessages</div>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Non lues</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalNonLus</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <form method="get" class="d-flex flex-wrap gap-2 align-items-center">
                <label for="Filtre" class="form-label mb-0">
                    Afficher :
                </label>

                <select id="Filtre"
                        name="Filtre"
                        class="form-select"
                        style="max-width: 220px">
                    <option value="TOUS" selected="@(Model.Filtre == "TOUS")">
                        Toutes les notifications
                    </option>
                    <option value="NON_LUS" selected="@(Model.Filtre == "NON_LUS")">
                        Non lues
                    </option>
                    <option value="LUS" selected="@(Model.Filtre == "LUS")">
                        Déjà lues
                    </option>
                </select>

                <button type="submit" class="btn btn-primary">
                    Filtrer
                </button>
            </form>
        </div>

        <div class="list-group list-group-flush">
            @if (Model.Messages.Count == 0)
            {
                <div class="p-4 text-center text-muted">
                    <div class="mb-2">
                        <i class="bi bi-bell-slash fs-2"></i>
                    </div>
                    Aucune notification à afficher.
                </div>
            }
            else
            {
                @foreach (var destinataire in Model.Messages)
                {
                    var message = destinataire.CodeMessageNavigation;

                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="flex-grow-1">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                    <strong>@message.Sujet</strong>

                                    @if (destinataire.DateLecture == null)
                                    {
                                        <span class="badge bg-primary">Non lu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Lu</span>
                                    }

                                    <span class="badge bg-light text-dark">
                                        @message.TypeMessage
                                    </span>
                                </div>

                                <p class="mb-2">@message.Contenu</p>

                                <small class="text-muted">
                                    Reçu le
                                    @destinataire.DateReception.ToString("dd/MM/yyyy à HH:mm")
                                </small>
                            </div>

                            @if (destinataire.DateLecture == null)
                            {
                                <form method="post"
                                      asp-page-handler="Lire"
                                      class="flex-shrink-0">
                                    <input type="hidden"
                                           name="codeMessage"
                                           value="@destinataire.CodeMessage" />

                                    <input type="hidden"
                                           name="Filtre"
                                           value="@Model.Filtre" />

                                    <button type="submit"
                                            class="btn btn-outline-primary btn-sm">
                                        Marquer comme lu
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <div class="mt-3">
        <a asp-page="/Index" class="btn btn-outline-secondary">
            Retour à l’accueil
        </a>
    </div>
</div>
