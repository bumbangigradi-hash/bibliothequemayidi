@page
@model bibliotheque_mayidi.Pages.EspaceLecteur.MesEmpruntsModel

@{
    ViewData["Title"] = "Mes emprunts";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h2">Mes emprunts et retraits</h1>
        <p class="text-muted">
            Bonjour @Model.NomLecteur, consultez vos documents empruntés
            et leurs dates de retour.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Emprunts en cours</div>
                    <div class="fs-3 fw-bold">@Model.TotalEnCours</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Emprunts en retard</div>
                    <div class="fs-3 fw-bold text-danger">@Model.TotalEnRetard</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Documents retournés</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalRetournes</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2">
                <label for="Filtre" class="form-label mb-0">Afficher :</label>

                <select id="Filtre"
                        name="Filtre"
                        class="form-select"
                        style="max-width: 260px">
                    <option value="EN_COURS"
                            selected="@(Model.Filtre == "EN_COURS")">
                        Emprunts en cours
                    </option>
                    <option value="EN_RETARD"
                            selected="@(Model.Filtre == "EN_RETARD")">
                        Emprunts en retard
                    </option>
                    <option value="RETOURNES"
                            selected="@(Model.Filtre == "RETOURNES")">
                        Documents retournés
                    </option>
                    <option value="TOUS"
                            selected="@(Model.Filtre == "TOUS")">
                        Tous les emprunts
                    </option>
                </select>

                <button type="submit" class="btn btn-primary">
                    Filtrer
                </button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Document</th>
                        <th>N° bordereau</th>
                        <th>Date de retrait</th>
                        <th>Date limite de retour</th>
                        <th>Statut</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Emprunts.Count == 0)
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">
                                Aucun emprunt ne correspond à ce filtre.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var emprunt in Model.Emprunts)
                        {
                            var enRetard =
                                emprunt.StatutLigne == "EN_COURS" &&
                                emprunt.DateEcheance <
                                    DateOnly.FromDateTime(DateTime.Today);

                            <tr>
                                <td>
                                    <strong>
                                        @emprunt.CodeExemplaireNavigation
                                        .CodeDocumentNavigation.Titre
                                    </strong>
                                    <div class="small text-muted">
                                        Cote :
                                        @emprunt.CodeExemplaireNavigation.Cote
                                    </div>
                                </td>
                                <td>
                                    @emprunt.CodeBordereauPretNavigation.NumeroBordereau
                                </td>
                                <td>
                                    @emprunt.DateRetrait.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @emprunt.DateEcheance.ToString("dd/MM/yyyy")
                                </td>
                                <td>
                                    @if (enRetard)
                                    {
                                        <span class="badge bg-danger">En retard</span>
                                    }
                                    else if (emprunt.StatutLigne == "EN_COURS")
                                    {
                                        <span class="badge bg-primary">En cours</span>
                                    }
                                    else if (emprunt.StatutLigne == "RETOURNE")
                                    {
                                        <span class="badge bg-success">Retourné</span>
                                    }
                                    else if (emprunt.StatutLigne == "MANQUANT")
                                    {
                                        <span class="badge bg-warning text-dark">Manquant</span>
                                    }
                                    else if (emprunt.StatutLigne == "PERDU")
                                    {
                                        <span class="badge bg-dark">Perdu</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @emprunt.StatutLigne
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <a asp-page="/EspaceLecteur/Notifications"
           class="btn btn-outline-primary">
            Mes notifications
        </a>

        <a asp-page="/Index" class="btn btn-outline-secondary">
            Retour à l’accueil
        </a>
    </div>
</div>
