@page
@model bibliotheque_mayidi.Pages.EspaceLecteur.MesReservationsModel

@{
    ViewData["Title"] = "Mes réservations";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="h2">Mes réservations et retraits</h1>
        <p class="text-muted">
            Bonjour @Model.NomLecteur, suivez l’état de vos réservations
            et les délais de retrait de vos documents.
        </p>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Toutes les réservations</div>
                    <div class="fs-3 fw-bold">@Model.TotalReservations</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">En attente</div>
                    <div class="fs-3 fw-bold text-warning">@Model.TotalEnAttente</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Prêtes à retirer</div>
                    <div class="fs-3 fw-bold text-primary">@Model.TotalPretes</div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted">Retraits effectués</div>
                    <div class="fs-3 fw-bold text-success">@Model.TotalRetraitsEffectues</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <form method="get" class="d-flex flex-wrap align-items-center gap-2">
                <label for="Filtre" class="form-label mb-0">Afficher :</label>

                <select id="Filtre"
                        name="Filtre"
                        class="form-select"
                        style="max-width: 280px">
                    <option value="TOUTES" selected="@(Model.Filtre == "TOUTES")">
                        Toutes les réservations
                    </option>
                    <option value="EN_ATTENTE" selected="@(Model.Filtre == "EN_ATTENTE")">
                        En attente de traitement
                    </option>
                    <option value="PRETES" selected="@(Model.Filtre == "PRETES")">
                        Prêtes à retirer
                    </option>
                    <option value="HONOREES" selected="@(Model.Filtre == "HONOREES")">
                        Retraits effectués
                    </option>
                    <option value="EXPIREES" selected="@(Model.Filtre == "EXPIREES")">
                        Expirées
                    </option>
                    <option value="ANNULEES" selected="@(Model.Filtre == "ANNULEES")">
                        Annulées ou refusées
                    </option>
                </select>

                <button type="submit" class="btn btn-primary">
                    Filtrer
                </button>
            </form>
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>N° réservation</th>
                        <th>Document</th>
                        <th>Date de réservation</th>
                        <th>État</th>
                        <th>Limite de retrait</th>
                        <th>Informations</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Reservations.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                Aucune réservation à afficher.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var reservation in Model.Reservations)
                        {
                            var delaiDepasse =
                                reservation.StatutReservation == "PRETE" &&
                                reservation.DateLimiteRetrait.HasValue &&
                                reservation.DateLimiteRetrait.Value < DateTime.Now;

                            <tr>
                                <td>
                                    <strong>@reservation.NumeroReservation</strong>
                                </td>
                                <td>
                                    <strong>@reservation.CodeDocumentNavigation.Titre</strong>
                                    @if (reservation.CodeExemplaireNavigation != null)
                                    {
                                        <div class="small text-muted">
                                            Cote : @reservation.CodeExemplaireNavigation.Cote
                                        </div>
                                    }
                                </td>
                                <td>
                                    @reservation.DateReservation.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td>
                                    @if (delaiDepasse)
                                    {
                                        <span class="badge bg-danger">Délai dépassé</span>
                                    }
                                    else if (reservation.StatutReservation == "PRETE")
                                    {
                                        <span class="badge bg-primary">Prête à retirer</span>
                                    }
                                    else if (reservation.StatutReservation == "HONOREE")
                                    {
                                        <span class="badge bg-success">Retrait effectué</span>
                                    }
                                    else if (reservation.StatutReservation == "EN_ATTENTE")
                                    {
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    }
                                    else if (reservation.StatutReservation == "EN_VERIFICATION")
                                    {
                                        <span class="badge bg-info text-dark">En vérification</span>
                                    }
                                    else if (reservation.StatutReservation == "EXPIREE")
                                    {
                                        <span class="badge bg-danger">Expirée</span>
                                    }
                                    else if (reservation.StatutReservation == "ANNULEE")
                                    {
                                        <span class="badge bg-secondary">Annulée</span>
                                    }
                                    else if (reservation.StatutReservation == "REFUSEE")
                                    {
                                        <span class="badge bg-dark">Refusée</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @reservation.StatutReservation
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (reservation.DateLimiteRetrait.HasValue)
                                    {
                                        @reservation.DateLimiteRetrait.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Non définie</span>
                                    }
                                </td>
                                <td>
                                    @if (reservation.StatutReservation == "PRETE")
                                    {
                                        <span>
                                            Présentez-vous à la bibliothèque avant
                                            la date limite indiquée.
                                        </span>
                                    }
                                    else if (reservation.StatutReservation == "REFUSEE")
                                    {
                                        <span>@(reservation.MotifRefus ?? "Réservation refusée")</span>
                                    }
                                    else if (reservation.StatutReservation == "HONOREE")
                                    {
                                        <span>
                                            Document retiré le
                                            @(reservation.DateRetraitEffectif?.ToString("dd/MM/yyyy HH:mm") ?? "date non renseignée")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            @(reservation.Observations ?? "Aucune information complémentaire")
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-3 d-flex flex-wrap gap-2">
        <a asp-page="/EspaceLecteur/MesEmprunts"
           class="btn btn-outline-primary">
            Mes emprunts
        </a>

        <a asp-page="/EspaceLecteur/Notifications"
           class="btn btn-outline-primary">
            Mes notifications
        </a>

        <a asp-page="/Index" class="btn btn-outline-secondary">
            Retour à l’accueil
        </a>
    </div>
</div>
